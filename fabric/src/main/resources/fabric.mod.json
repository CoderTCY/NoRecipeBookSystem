{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "icon": "icon.png",
    "license": "${license}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "${group}.fabric.NoRecipeBookSystemFabric"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "minecraft": "${fabric_minecraft_version_range}",
        "java": ">=${java_version}"
    }
}
  